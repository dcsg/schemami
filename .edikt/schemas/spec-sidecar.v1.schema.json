{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edikt.dev/schemas/spec-sidecar/v1.json",
  "title": "edikt SPEC sidecar",
  "description": "Structured sidecar (.yaml) that accompanies a v2 SPEC. Source of truth for requirements, ACs, coverage, and cross-references. adds source_prd/source_brainstorm/source_prompt fields to support SPECs with no upstream PRD.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "type",
    "id",
    "title",
    "status",
    "author",
    "created_at"
  ],
  "allOf": [
    {
      "description": "BRAIN-NNN decision 28: exactly one of source_prd / source_brainstorm / source_prompt MUST be non-null. Encoded as oneOf so a sidecar with all three null OR more than one set fails validation.",
      "oneOf": [
        {
          "required": [
            "source_prd"
          ],
          "properties": {
            "source_prd": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "source_brainstorm"
          ],
          "properties": {
            "source_brainstorm": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "source_prompt"
          ],
          "properties": {
            "source_prompt": {
              "type": "string"
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Sidecar schema version. PRD/SPEC sidecars use a string semver (\"1.0\") so additive field changes can ship as 1.1, 1.2, \u2026 within v1.x. The governance sidecar (gov-sidecar.v1.schema.json) intentionally uses a discrete integer (1) because its on-disk shape is a v1-or-v2 contract, not a semver-versioned one. Used by /edikt:doctor to flag stale sidecars."
    },
    "type": {
      "type": "string",
      "enum": [
        "spec"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^SPEC-\\d{3,}$",
      "description": "Stable SPEC identifier, e.g. SPEC-NNN."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Kebab-case slug used in filenames. Matches the PRD sidecar slug field so PRD/SPEC pairs share a consistent identity model."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "accepted",
        "in-progress",
        "shipped",
        "evolving",
        "superseded",
        "deprecated",
        "cancelled"
      ],
      "description": "Lifecycle status. draft \u2192 accepted \u2192 in-progress \u2192 shipped (\u2192 evolving for post-ship iteration). Terminal states: superseded | deprecated | cancelled. PRDs and SPECs share this enum so a status from one artifact class is meaningful when surfaced alongside the other."
    },
    "author": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_prd": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PRD-\\d{3,}$",
      "description": "Set when this SPEC derives from a PRD. Exactly one of source_prd / source_brainstorm / source_prompt is non-null."
    },
    "source_brainstorm": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^BRAIN-\\d{3,}$",
      "description": "Set when this SPEC derives from a brainstorm doc. The brainstorm's produced_specs: receives a back-reference."
    },
    "source_prompt": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when this SPEC is self-contained (no upstream artifact). Stores the originating prompt (\u2264200 chars). No back-reference written."
    },
    "source_prd_coverage": {
      "type": "object",
      "description": "Only present when source_prd is set and PRD is v2. Emitted by /edikt:sdlc:spec (FR-007 change 1).",
      "required": [
        "prd"
      ],
      "properties": {
        "prd": {
          "type": "string",
          "pattern": "^PRD-\\d{3,}$"
        },
        "covered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fr",
              "by"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "pattern": "^FR-[A-Z][A-Z0-9]*-\\d{3,}$"
              },
              "by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SR-[A-Z][A-Z0-9]*-\\d{3,}$"
                }
              }
            }
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fr",
              "rationale"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "pattern": "^FR-[A-Z][A-Z0-9]*-\\d{3,}$"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "uncovered": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FR-[A-Z][A-Z0-9]*-\\d{3,}$"
          },
          "description": "Non-empty list blocks /edikt:sdlc:drift."
        }
      }
    },
    "requirements": {
      "type": "array",
      "description": "SPEC requirements (SR-NNN). Each may implement a PRD FR-NNN.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SR-[A-Z][A-Z0-9]*-\\d{3,}$"
          },
          "implements": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^FR-[A-Z][A-Z0-9]*-\\d{3,}$",
            "description": "Links to PRD FR. Null for spec-only requirements."
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "verify": {
            "type": "string",
            "minLength": 1,
            "description": "Optional shell command that returns exit 0 when this SR is satisfied. Run via `bin/edikt verify spec <SPEC-ID>`. Used by `/edikt:sdlc:drift` (verify failures contribute to the drift signal) and by the completion-evidence discipline. Omit when no programmatic check is possible \u2014 the field stays absent, not empty."
          },
          "verify_kind": {
            "type": "string",
            "enum": [
              "behavioral",
              "tooling",
              "structural"
            ],
            "description": "Discriminator for the cheat-rate benchmark. Optional; required only when this SR should be scored by `bin/edikt gov benchmark cheat-rate`. Same semantics as gov-sidecar verify_kind."
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Optional one-line semantic claim the verify is meant to falsify. Generator-neutral; consumed by the cheat-rate adversary prompt when verify_kind: behavioral."
          },
          "falsifying_observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Optional one-line description of what a violation looks like. Sibling of intent; consumed by the cheat-rate adversary prompt."
          },
          "positive_fixture_path": {
            "type": "string",
            "description": "Optional path to a positive-fixture script (exits 0 against a compliant state)."
          },
          "negative_fixture_path": {
            "type": "string",
            "description": "Optional path to a negative-fixture script (used by the cheat-rate verdict layer as the discriminator)."
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "AC-NNN-M from PRD (pass-through, source: prd) + SAC-NNN added by SPEC (source: spec).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(AC-[A-Z][A-Z0-9]*-\\d{3,}-\\d+|SAC-[A-Z][A-Z0-9]*-\\d{3,})$"
          },
          "source": {
            "type": "string",
            "enum": [
              "prd",
              "spec"
            ]
          },
          "fr": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^FR-[A-Z][A-Z0-9]*-\\d{3,}$"
          },
          "given": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          },
          "verify": {
            "type": "string",
            "minLength": 1,
            "description": "Optional shell command that mechanically validates the Given/When/Then. Exit 0 = the AC passes. Run via `bin/edikt verify spec <SPEC-ID>`; used by the drift command and the completion-evidence discipline. Omit when no programmatic check is possible."
          },
          "verify_kind": {
            "type": "string",
            "enum": [
              "behavioral",
              "tooling",
              "structural"
            ],
            "description": "Discriminator for the cheat-rate benchmark."
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "falsifying_observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "positive_fixture_path": {
            "type": "string"
          },
          "negative_fixture_path": {
            "type": "string"
          }
        }
      }
    },
    "protections": {
      "type": "array",
      "description": "Inherited from PRD (source: prd) + spec-layer additions (source: spec). Mirrors the PRD sidecar's oneOf shape: each entry is EITHER a reference to an existing INV ({ref, note?}) OR a self-contained protection ({id, text}). The source discriminator records provenance.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^INV-\\d{3,}$"
              },
              "note": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "prd",
                  "spec"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S?SP-\\d{3,}$",
                "description": "Feature-scoped protection (SP-NNN from PRD, SSP-NNN added at SPEC layer). Promote to an INV if durable."
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "prd",
                  "spec"
                ]
              }
            }
          }
        ]
      }
    },
    "solution_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path_or_url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "figma",
              "screenshot",
              "url",
              "doc",
              "diagram",
              "prototype",
              "generated"
            ],
            "description": "Reference type. Aligned with the PRD sidecar enum so PRD inheritance is type-safe; 'diagram' and 'generated' are both accepted across PRD and SPEC."
          },
          "path_or_url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "prd",
              "spec"
            ]
          }
        }
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SPEC-\\d{3,}$",
      "description": "When this SPEC supersedes a prior one, the earlier SPEC's ID. Mirrors the PRD sidecar's supersedes field."
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SPEC-\\d{3,}$",
      "description": "When this SPEC has been superseded, the replacing SPEC's ID. Set by /edikt:sdlc:spec on supersede transition."
    },
    "deprecated_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO8601 timestamp when status moved to deprecated."
    },
    "deprecated_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "One-line rationale captured at deprecate time."
    },
    "cancelled_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO8601 timestamp when status moved to cancelled."
    },
    "cancelled_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "One-line rationale captured at cancel time."
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "author",
          "action"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "edited",
              "ship",
              "deprecate",
              "cancel",
              "supersede",
              "resync",
              "review"
            ]
          },
          "note": {
            "type": "string"
          },
          "affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "User-managed extension zone. LLM NEVER writes here; commands NEVER mutate this key. Free-form structure. Mirrors the PRD sidecar's extensions zone.",
      "additionalProperties": true
    },
    "_sync": {
      "type": "object",
      "required": [
        "md_hash",
        "yaml_hash",
        "synced_at"
      ],
      "description": "Sync block mirroring the PRD sidecar's _sync. /edikt:doctor uses these hashes to detect when the .md and .yaml have drifted out of sync.",
      "properties": {
        "md_hash": {
          "type": "string",
          "description": "SHA-256 of the .md file at last sync. Empty string if never synced."
        },
        "yaml_hash": {
          "type": "string",
          "description": "SHA-256 of the .yaml file at last sync (self-referential; recomputed post-write)."
        },
        "synced_at": {
          "type": "string",
          "description": "ISO8601 timestamp of last sync."
        }
      }
    },
    "design": {
      "type": "object",
      "description": "PROJECT EXTENSION (traceability guideline): addressable how-layer. Design statements (DS) are individually adjustable decisions; components (CMP) are buildable units. serves: links each to the SR ids it realizes.",
      "additionalProperties": false,
      "properties": {
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "serves",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^DS-[A-Z][A-Z0-9]*-\\d{3,}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "serves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(SR|FR)-[A-Z][A-Z0-9]*-\\d{3,}$"
                },
                "minItems": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "accepted",
                  "adjusted",
                  "deprecated"
                ]
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "description",
              "serves",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CMP-[A-Z][A-Z0-9]*-\\d{3,}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "serves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SR-[A-Z][A-Z0-9]*-\\d{3,}$"
                },
                "minItems": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "accepted",
                  "built",
                  "deprecated"
                ]
              }
            }
          }
        }
      }
    }
  }
}