{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemami.dev/contracts/source-to-candidate/1/acquisition-request.schema.json",
  "title": "Schemami source-to-candidate acquisition request 1",
  "type": "object",
  "required": ["contract", "document", "sources"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "https://schemami.dev/contracts/source-to-candidate/1"},
    "document": {
      "type": "object",
      "required": ["kind", "content_language"],
      "dependentRequired": {
        "collection": ["id", "revision"],
        "id": ["collection", "revision"],
        "revision": ["collection", "id"]
      },
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "recipe"},
        "collection": {"$ref": "#/$defs/local_id"},
        "id": {"$ref": "#/$defs/local_id"},
        "revision": {"type": "integer", "minimum": 1},
        "content_language": {"type": "string", "minLength": 2, "maxLength": 128, "format": "language-tag"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "authorized_component_references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/recipe_reference"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "local_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/local_id"},
        "kind": {"enum": ["text", "url", "image", "document", "audio", "application_data"]},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 255},
        "uri": {"type": "string", "minLength": 1, "format": "uri-reference"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recipe_reference": {
      "type": "object",
      "required": ["collection", "id", "revision", "sha256"],
      "additionalProperties": false,
      "properties": {
        "collection": {"$ref": "#/$defs/local_id"},
        "id": {"$ref": "#/$defs/local_id"},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
