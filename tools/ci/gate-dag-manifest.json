{
  "schema_version": 1,
  "purpose": "Ordered, non-recursive Schemami v1 local/CI gate DAG.",
  "stages": [
    {"id": "toolchain", "command": "make toolchain-check", "owns": ["Go/Bun pins and locks"]},
    {"id": "sdk-resources", "command": "make sdk-resources", "owns": ["Go, TypeScript, and Swift embedded schema/conformance resource parity"]},
    {"id": "go-sdk", "command": "make go-sdk", "owns": ["Go Core, Calculus, Diff, strict admission, and external-consumer contract"]},
    {"id": "typescript-sdk", "command": "make typescript-sdk", "owns": ["TypeScript Core, Calculus, Diff, declarations, and package imports"]},
    {"id": "go", "command": "tools/with-toolchain.sh go -C tools/schemami test -count=1 ./...", "owns": ["CLI, semantics, canonicalization, Calculus"]},
    {"id": "validate", "command": "make validate", "owns": ["core and bundle schema admission"]},
    {"id": "conformance", "command": "make conformance", "owns": ["shared Go/TypeScript operation and refusal corpus"]},
    {"id": "bundle", "command": "make bundle", "owns": ["self-contained offline bundle closure"]},
    {"id": "viewer", "command": "make viewer", "owns": ["Schemami-only viewer and generated bundle"]},
    {"id": "cutover", "command": "make cutover", "owns": ["active legacy-surface classification"]},
    {"id": "release-contract", "command": "make release-contract", "owns": ["local normative URL map and problem-type artifacts"]}
  ]
}
