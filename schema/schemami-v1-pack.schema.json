{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemami.dev/schema/schemami/1/pack.schema.json",
  "title":"Schemami Pack v1",
  "type":"object",
  "required":["schemami","collection","revision","documents"],
  "additionalProperties":false,
  "patternProperties":{"^x-[a-z0-9]+(?:-[a-z0-9]+)*$":{}},
  "properties":{
    "schemami":{"const":"1"},
    "collection":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$"},
    "revision":{"type":"integer","minimum":1},
    "documents":{"type":"array","minItems":1,"items":{"type":"object","required":["id","revision","sha256"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$"},"revision":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
  }
}
